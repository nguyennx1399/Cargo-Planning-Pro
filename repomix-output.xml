INVALID_LINE_NO_EQUALS
ANOTHER_VALID=test
""")

        result = EnvLoader.load_env_file(env_file)

        assert result['VALID_KEY'] == 'value'
        assert result['ANOTHER_VALID'] == 'test'
        assert 'INVALID_LINE_NO_EQUALS' not in result

