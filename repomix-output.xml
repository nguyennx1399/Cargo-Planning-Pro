        (tmp_path / "image1.jpg").touch()
        (subdir / "image2.jpg").touch()

        images = collect_images([tmp_path], recursive=True)
        assert len(images) == 2

        images_non_recursive = collect_images([tmp_path], recursive=False)
        assert len(images_non_recursive) == 1

