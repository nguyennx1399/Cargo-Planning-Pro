  ]},
  {"question": "Colors?", "header": "Colors", "multiSelect": false, "options": [
    {"label": "Auto-select (Recommended)", "description": "AI chooses"},
    {"label": "Warm tones", "description": "Oranges, reds"},
    {"label": "Cool tones", "description": "Blues, greens"},
