<file path="frontend/src/App.tsx">
import { useQuery } from "@tanstack/react-query";
import { api } from "@/api/client";
import { VesselScene } from "@/features/viewer3d/VesselScene";
import { Sidebar } from "@/features/panels/Sidebar";
import { BayPlanView } from "@/features/bayplan/BayPlanView";

export default function App() {
  const planQ = useQuery({ queryKey: ["plan", "demo"], queryFn: () => api.demoPlan() });
  const vesselId = planQ.data?.vessel_id;
  const vesselQ = useQuery({
    queryKey: ["vessel", vesselId],
    queryFn: () => api.vessel(vesselId!),
    enabled: !!vesselId,
  });
  const reportQ = useQuery({
    queryKey: ["validate", planQ.data?.id],
    queryFn: () => api.validate(planQ.data!),
    enabled: !!planQ.data,
  });

  const error = planQ.error ?? vesselQ.error;
  if (error) {
    return (
      <div className="state">
        <p>Could not load the plan: {String(error.message)}</p>
        <p className="muted">Start the backend with <code>uvicorn app.main:app --reload</code> on port 8000, then reload.</p>
      </div>
    );
  }
  if (!planQ.data || !vesselQ.data) return <div className="state">Loading vessel and plan…</div>;

  return (
    <div className="layout">
      <Sidebar vessel={vesselQ.data} plan={planQ.data} report={reportQ.data} />
      <main className="stage">
        <div className="viewport">
          <VesselScene vessel={vesselQ.data} plan={planQ.data} />
        </div>
        <div className="bayplan">
          <BayPlanView vessel={vesselQ.data} plan={planQ.data} />
        </div>
      </main>
    </div>
  );
}
</file>

